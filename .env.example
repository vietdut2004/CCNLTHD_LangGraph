# Copy to .env and fill in your own keys. Never put keys in frontend files.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional: needed only for web searches.
TAVILY_API_KEY=
# First document query may download this model if it is not cached.
EMBEDDING_MODEL=VoVanPhuc/sup-SimCSE-VietNamese-phobert-base
