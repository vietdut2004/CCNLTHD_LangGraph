{
  "openapi": "3.1.0",
  "info": {
    "title": "Chatbot tham khao - evidence-v1",
    "version": "2.0"
  },
  "paths": {
    "/chatbot": {
      "post": {
        "summary": "Chatbot Reply",
        "operationId": "chatbot_reply_chatbot_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageOut"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageOut"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageOut"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageOut"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageOut"
                }
              }
            }
          },
          "504": {
            "description": "Gateway Timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageOut"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MessageIn": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Question"
          },
          "mode": {
            "type": "string",
            "enum": [
              "auto",
              "chat",
              "rag",
              "web"
            ],
            "title": "Mode",
            "default": "auto"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "use_cache": {
            "type": "boolean",
            "title": "Use Cache",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "MessageIn"
      },
      "MessageOut": {
        "properties": {
          "response": {
            "type": "string",
            "title": "Response"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "refused",
              "error"
            ],
            "title": "Status"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "graph_id": {
            "type": "string",
            "title": "Graph Id"
          },
          "model_id": {
            "type": "string",
            "title": "Model Id"
          },
          "route": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Route"
          },
          "sources": {
            "items": {},
            "type": "array",
            "title": "Sources"
          },
          "usage": {
            "additionalProperties": true,
            "type": "object",
            "title": "Usage"
          }
        },
        "type": "object",
        "required": [
          "response",
          "status",
          "code",
          "trace_id",
          "graph_id",
          "model_id"
        ],
        "title": "MessageOut"
      }
    }
  }
}